  "head": "<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Undergraduate Thesis — Dinan Mariano</title>\n<meta name=\"description\" content=\"A visual research showcase of the structural and electronic properties of two-dimensional (MoWVNbTa)S₂.\">\n<meta property=\"og:title\" content=\"First-Principles Investigation of the Structural and Electronic Properties of Two-Dimensional (MoWVNbTa)S₂\">\n<meta property=\"og:description\" content=\"Explore the atomic model, electronic bands, charge redistribution and density of states from my undergraduate research.\">\n<meta property=\"og:type\" content=\"article\">\n<meta property=\"og:image\" content=\"https://mscid.github.io/assets/thesis/crystal-structure.png\">\n<link rel=\"icon\" href=\"/logo/logo.png\">",
